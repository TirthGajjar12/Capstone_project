# Application Settings
APP_NAME=IT Asset & Support Ticket Management
APP_ENV=development
DEBUG=True

# Database (PostgreSQL) Settings
# Option A: Full Connection String (Recommended for Neon.tech / Render / Cloud Postgres)
# DATABASE_URL=postgresql://neondb_owner:your_password@ep-xxxx-pooler.us-east-2.aws.neon.tech/neondb?sslmode=require

# Option B: Individual connection parameters (for local Docker or local Postgres)
DB_HOST=localhost
DB_PORT=5432
DB_USER=root
DB_PASSWORD=your_password
DB_NAME=it_asset_db
# DB_SSLMODE=require  # Uncomment if connecting directly to Neon with split params

# CORS Settings (comma-separated list of allowed frontend URLs)
# CORS_ORIGINS=http://localhost:5173,http://localhost:3000,https://your-app.pages.dev

# Security / JWT Settings
SECRET_KEY=your_secret_key
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

# RSA Key Configuration (Optional: defaults to writing/loading keys/rsa_private.pem)
# RSA_PRIVATE_KEY_PEM="-----BEGIN PRIVATE KEY-----\n..."
# RSA_PRIVATE_KEY_PATH=keys/rsa_private.pem
